# ===================================
# Super Claude Multi-Agents - Configuration
# ===================================

# -----------------------------------
# Anthropic Configuration (Phase 2)
# -----------------------------------
# Clé API Anthropic (obligatoire pour l'équipe Anthropic)
ANTHROPIC_API_KEY=sk-ant-api03-...

# Modèle Anthropic à utiliser
# Options: claude-3-5-sonnet-20241022, claude-3-opus-20240229, claude-3-sonnet-20240229
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Chemin custom du bridge Anthropic (optionnel)
# Par défaut: agents/anthropic/bridge.py
# ANTHROPIC_BRIDGE_PATH=agents/anthropic/bridge.py

# -----------------------------------
# ADK Configuration (Google A2A)
# -----------------------------------
# Chemin du bridge ADK
# ADK_BRIDGE_PATH=/Users/sahebmlik/.gemini/bridge.py

# -----------------------------------
# OpenAI Configuration (Phase 3 - Planned)
# -----------------------------------
# Clé API OpenAI
# OPENAI_API_KEY=sk-...

# Modèle OpenAI à utiliser
# OPENAI_MODEL=gpt-4

# Chemin custom du bridge OpenAI
# OPENAI_BRIDGE_PATH=agents/openai/bridge.py

# -----------------------------------
# Super Claude - Paramètres Généraux
# -----------------------------------
# Timeout pour les bridges (secondes)
BRIDGE_TIMEOUT=60

# Timeout pour les agents (secondes)
AGENT_TIMEOUT=120

# Niveau de logging
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# -----------------------------------
# Skills & Execution Modes
# -----------------------------------
# Répertoire des skills
# SKILLS_DIR=skills

# Mode d'exécution par défaut
# Options: simple, hybrid, complex
# DEFAULT_EXECUTION_MODE=hybrid

# -----------------------------------
# MCP Configuration
# -----------------------------------
# Fichier de configuration des serveurs MCP
# MCP_SERVER_CONFIG=mcp/servers.json

# -----------------------------------
# Testing & Development
# -----------------------------------
# Mode de test (utilise des mocks au lieu des vrais APIs)
# TEST_MODE=false

# Clé API factice pour les tests
# TEST_API_KEY=sk-test-dummy-key

# -----------------------------------
# Sécurité
# -----------------------------------
# Ne jamais commiter de vraies clés API
# Utiliser des secrets managers en production
# Exemple: AWS Secrets Manager, HashiCorp Vault, etc.
